# ============================================================
# .env.example — 環境變數範本
# 使用方式：複製此檔案為 .env，填入真實值，不要 commit .env 到 git
# ============================================================

# ── App 基本設定 ──────────────────────────────────────────────
APP_NAME=廠務法規許可標準化管理平台
DEBUG=True        # 正式環境改為 False

# ── SQL Server 連線字串 ───────────────────────────────────────
# 格式：mssql+pyodbc://帳號:密碼@IP或主機名/資料庫名?driver=ODBC+Driver+17+for+SQL+Server
#
# 舊系統 Web.config 的 DB 對應：
#   DB_VOC_URL      ← DataBaseCI.VOC (連線 1)    主業務資料庫，所有 VOC_* 資料表
#   DB_SIGNFLOW_URL ← SignFlow DB               簽核流程資料表
#   DB_UTIDB_URL    ← DataBaseCI.UTIDB (連線 2) 員工資料（工號、部門、姓名）
#
DB_VOC_URL=mssql+pyodbc://帳號:密碼@資料庫IP/VOC?driver=ODBC+Driver+17+for+SQL+Server
DB_SIGNFLOW_URL=mssql+pyodbc://帳號:密碼@資料庫IP/SignFlow?driver=ODBC+Driver+17+for+SQL+Server
DB_UTIDB_URL=mssql+pyodbc://帳號:密碼@資料庫IP/UTIDB?driver=ODBC+Driver+17+for+SQL+Server

# ── Oracle CIM 連線（唯讀）────────────────────────────────────
# 來源：舊版 Web.config 的 OraCIMConnStr
# 注意：正式環境不應把帳密寫在此處，應改用 Vault 或環境變數注入
DB_CIM_URL=oracle+oracledb://fac-cim:faccim@10.10.22.192:1521/?service_name=facpdb

# ── LDAP 認證 ─────────────────────────────────────────────────
# 公司 Active Directory 伺服器位址
# 舊版 Web.config 使用 Windows 認證，新系統改為 LDAP → JWT
LDAP_SERVER=ldap://KH
# LDAP_BASE_DN=DC=company,DC=com   # 若需要，請向 IT 確認完整 DN

# ── ACL 權限強制模式 ──────────────────────────────────────────
# False（預設）：check_permission 權限不足時只記 log，仍然放行（避免權限資料未建置就鎖死系統）。
# True：權限不足直接擋下操作。
# 🔴🔴 正式環境務必確認 sys_acluserrole / sys_aclrolerights 資料建置完成後，將此值改為 True！
ACL_ENFORCE=False

# ── 登入 Mock 模式 ────────────────────────────────────────────
# True（預設，僅供開發）：允許 admin/admin 假帳密登入。
# False：停用 Mock，一律回「LDAP 尚未實作」（LDAP 串接依專案決策延後，尚未實作）。
# 🔴🔴🔴 正式環境部署前務必改為 False！保持 True 會讓任何人都能用 admin/admin 登入正式系統！
AUTH_MOCK=True

# ── 雙軌測試模式 ──────────────────────────────────────────────
# TEST_MODE=True 時：Email 和 SMS 不會真的發出，改寄到下方測試帳號
# 開發 / 測試環境維持 True；正式切換時改為 False
TEST_MODE=True
TEST_DEV_EMAIL=你的測試信箱@company.com
TEST_DEV_PHONE=0912345678

# 測試用「固定副本」：所有寄出的信一律 CC 到這裡（多個用逗號分隔），方便自己確認信件有寄出
# （非上班時間也能收到副本驗證，不必等同事回報）。TEST_MODE=False（真的寄給同事）時才有意義；
# TEST_MODE=True 時信已全部改寄 TEST_DEV_EMAIL。留空＝不加固定副本。正式上線務必清空。
ALWAYS_CC_EMAIL=

# ── Schema B（Phase A 重構版）資料庫連線 ────────────────────────
# 本機／沙盒測試：先跑 `bash scripts/dev_pg.sh` 建好本機 PostgreSQL 後即可用下方預設值。
# 公司/正式測試環境：改成該環境實際的 PG 連線字串（帳密/主機/db 名依實際建置調整）。
# 正式環境引擎尚未定案（PG 或 MSSQL），詳見 docs/schema_B_設計提案.md 第五節「引擎可攜規範」。
VOC_B_DB_URL=postgresql+psycopg2://voc:voc@localhost/voc_b

# ── B 棧 Mock 操作者身分（Phase A 閉環測試用）────────────────────
# current_user 尚未接 LDAP（Phase 3），B 棧的申請/簽核/QA 等操作一律視為這個身分送出。
# 測試「申請人≠簽核人」的簽核閉環時，在 TEST001（申請人）／TEST999（簽核人，種子資料內建
# 的雙測試身分）之間切換即可（簽核排除申請人本人是舊系統原設計）。LDAP 完成後此設定廢除。
MOCK_USER_EMPNO=TEST001
MOCK_USER_NAME=測試申請人
